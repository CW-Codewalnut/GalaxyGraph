{
  "name": "@galaxy-graph/example-standalone-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:standalone": "vite build && node ../../scripts/inline-vite-assets-for-standalone-html.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@galaxy-graph/core": "0.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.2.4",
    "typescript": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "description": "Standalone Galaxy Graph viewer used by adapter generation scripts"
}
